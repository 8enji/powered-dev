{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "1-3 sentence overview of the review."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "side", "severity", "body"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Repository-relative file path."
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line number in the file at the PR head SHA, on the side specified."
          },
          "side": {
            "type": "string",
            "enum": ["LEFT", "RIGHT"],
            "description": "LEFT = pre-change side, RIGHT = post-change side. Use RIGHT for findings about added/modified code."
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor", "nit"],
            "description": "critical = blocks merge; major = should fix before merge; minor = consider fixing; nit = stylistic."
          },
          "body": {
            "type": "string",
            "description": "Markdown-formatted finding. Be specific; suggest a fix when obvious."
          }
        }
      }
    }
  }
}
