{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command // empty'); case \"$CMD\" in *\"git commit\"*|*\"git merge\"*) ;; *) exit 0 ;; esac; cd \"${CLAUDE_PROJECT_DIR:-$(pwd)}\" && __GATE_CMD__ 1>&2 || exit 2",
            "if": "Bash(git *)",
            "timeout": 120,
            "statusMessage": "Pre-commit gate: lint + typecheck"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(pwd)}/scripts/claude_hooks/pre_merge_gate.sh\"",
            "if": "Bash(git merge*)",
            "timeout": 10,
            "statusMessage": "Pre-merge gate (blocks if active plan)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(pwd)}/scripts/claude_hooks/pre_merge_gate.sh\"",
            "if": "Bash(git push*)",
            "timeout": 10,
            "statusMessage": "Pre-push gate (blocks if active plan)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(pwd)}/scripts/claude_hooks/pre_merge_gate.sh\"",
            "if": "Bash(gh pr create*)",
            "timeout": 10,
            "statusMessage": "Pre-PR gate (blocks if active plan)"
          }
        ]
      }
    ]
  }
}
