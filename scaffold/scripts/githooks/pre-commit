#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPTS="$REPO_ROOT/scripts"
FAIL=0

echo "powered-dev: running board checks..."

# 1. Lint backlog for duplicate titles
if ! python3 "$SCRIPTS/board.py" lint-backlog; then
    FAIL=1
fi

# 2. Regenerate INDEX.md and check for drift
python3 "$SCRIPTS/docs_index.py" regenerate
if ! git diff --exit-code -- docs/superpowers/INDEX.md > /dev/null 2>&1; then
    echo "error: docs/superpowers/INDEX.md is out of date."
    echo "  The regenerated file has been written. Stage it and amend your commit:"
    echo "    git add docs/superpowers/INDEX.md"
    FAIL=1
fi

# 3. Lint frontmatter on staged docs
STAGED_DOCS=$(git diff --cached --name-only --diff-filter=ACM -- 'docs/superpowers/specs/*.md' 'docs/superpowers/plans/*.md' 'docs/superpowers/reports/*.md' 'docs/superpowers/handoffs/*.md' 2>/dev/null || true)
if [ -n "$STAGED_DOCS" ]; then
    if ! python3 "$SCRIPTS/docs_index.py" lint $STAGED_DOCS; then
        FAIL=1
    fi
fi

# 4. CLAUDE.md line budget
MAX_LINES=${POWERED_DEV_CLAUDE_MD_MAX_LINES:-50}
if [ -f "$REPO_ROOT/CLAUDE.md" ]; then
    LINES=$(wc -l < "$REPO_ROOT/CLAUDE.md")
    if [ "$LINES" -gt "$MAX_LINES" ]; then
        echo "error: CLAUDE.md exceeds ${MAX_LINES}-line budget (has ${LINES} lines)"
        FAIL=1
    fi
fi

exit $FAIL
